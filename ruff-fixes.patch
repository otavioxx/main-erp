+[tool.ruff]
+target-version = "py310"
+extend-exclude = ["main.spec"]
+
+[tool.ruff.lint]
+# Regras ligadas: erros reais (F, B, E4/E7/E9), imports ordenados (I) e as
+# famílias de "exceção" que já foram zeradas (não deixe voltar).
+select = [
+    "E4", "E7", "E9", "F", "B", "I",
+    "S110", "S112",              # try/except/pass e try/except/continue
+    "TRY002", "TRY201", "TRY203",  # raise Exception(...), raise e, handler inútil
+    "RUF012", "RUF013", "RUF059",  # tipos e variáveis não usadas
+    "PLW1510",                   # subprocess.run sem check=
+    "SIM102", "SIM103", "SIM117",  # if/with desnecessariamente aninhados
